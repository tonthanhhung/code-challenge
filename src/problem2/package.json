  "version": "0.0.0",
  "type": "module",
  "homepage": "https://tonthanhhung.github.io/code-challenge/currency-swap",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "predeploy": "npm run build && npm run build:deploy",
    "build:deploy": "rm -rf deploy && mkdir -p deploy/currency-swap && cp -r dist/* deploy/currency-swap/ && touch deploy/.nojekyll",
    "deploy": "gh-pages -d deploy -b gh-pages -f",
    "deploy:clean": "git push origin --delete gh-pages",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
